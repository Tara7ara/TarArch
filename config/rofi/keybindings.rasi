/* =============================================================================
   ROFI KEYBINDINGS CHEATSHEET — PALETA TARARCH WARM DARK
   Fondo opaco (rofi va sin blur en Hyprland y con alpha se transparenta lo de
   detrás). Teclas en monoespaciada y naranja, descripción en Inter; el markup
   de cada fila sale de keybindings-lib.sh.
   ============================================================================= */

configuration {
    modi:                "dmenu";
    show-icons:          false;
    disable-history:     true;
}

* {
    font:             "Inter 11";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0f;
    border:           1px;
    border-color:     #2d2d2d;
    border-radius:    12px;
    width:            760px;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [inputbar, listview];
    spacing:          0;
}

inputbar {
    padding:          16px 20px;
    spacing:          12px;
    border:           0 0 1px 0;
    border-color:     #2d2d2d;
    children:         [prompt, entry];
}

prompt {
    text-color:       #6e6e6e;
    font:             "Inter 11";
    vertical-align:   0.5;
}

entry {
    text-color:       #ffffff;
    placeholder:      "Buscar atajo o comando";
    placeholder-color: #6e6e6e;
    vertical-align:   0.5;
    cursor-color:     #ff9e64;
}

listview {
    columns:          1;
    lines:            14;
    scrollbar:        false;
    spacing:          0;
    padding:          8px 8px 10px 8px;
    fixed-height:     true;
}

element {
    padding:          7px 12px;
    border:           0 0 0 2px;
    border-color:     transparent;
    border-radius:    6px;
    cursor:           pointer;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
}

element normal normal,
element alternate normal {
    background-color: transparent;
}

element selected normal {
    background-color: #1c1a19;
    border-color:     #ff9e64;
}
