/* =============================================================================
   ROFI SELECTOR DE FONDOS (respaldo del coverflow) — PALETA TARARCH WARM DARK
   Cuadrícula de miniaturas; la seleccionada lleva borde naranja fino.
   ============================================================================= */

configuration {
    show-icons:          true;
    drun-display-format: "{name}";
}

* {
    font:             "Inter 10";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0f;
    border:           1px;
    border-color:     #2d2d2d;
    border-radius:    12px;
    width:            820px;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [inputbar, listview];
    spacing:          0;
}

inputbar {
    padding:          16px 20px;
    spacing:          12px;
    border:           0 0 1px 0;
    border-color:     #2d2d2d;
    children:         [prompt, entry];
}

prompt {
    text-color:       #6e6e6e;
    font:             "Inter 11";
    vertical-align:   0.5;
}

entry {
    font:             "Inter 11";
    text-color:       #ffffff;
    placeholder:      "Buscar fondo";
    placeholder-color: #6e6e6e;
    vertical-align:   0.5;
    cursor-color:     #ff9e64;
}

listview {
    columns:          3;
    lines:            3;
    spacing:          10px;
    padding:          14px;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
}

element {
    padding:          8px;
    spacing:          6px;
    orientation:      vertical;
    border:           1px;
    border-color:     transparent;
    border-radius:    8px;
    cursor:           pointer;
}

element selected {
    background-color: #1c1a19;
    border-color:     #ff9e64;
}

element-icon {
    size:             150px;
    horizontal-align: 0.5;
    cursor:           inherit;
}

element-text {
    text-color:       #6e6e6e;
    horizontal-align: 0.5;
    cursor:           inherit;
}

element-text selected {
    text-color:       #ffffff;
}
