/* =============================================================================
   ROFI WIFI MANAGER — PALETA TARARCH WARM DARK
   ============================================================================= */

* {
    font:             "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0fef;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.10);
    border-radius:    20px;
    width:            600px;
    padding:          16px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children:         [inputbar, listview];
    spacing:          12px;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.05);
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.08);
    border-radius:    14px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       #ff9e64;
    font:             "JetBrainsMono Nerd Font 14";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       #ffffff;
    placeholder:      "Seleccionar red WiFi...";
    placeholder-color: rgba(255, 255, 255, 0.25);
    vertical-align:   0.5;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            7;
    scrollbar:        false;
    spacing:          6px;
    fixed-height:     false;
}

element {
    background-color: rgba(255, 255, 255, 0.03);
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.05);
    border-radius:    12px;
    padding:          10px 14px;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
    font:             "JetBrainsMono Nerd Font 12";
}

element normal normal {
    text-color: #c9c9c9;
}

element selected normal {
    background-color: rgba(255, 158, 100, 0.16);
    border:           1px;
    border-color:     #ff9e64;
    text-color:       #ffffff;
}
