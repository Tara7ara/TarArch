/* =============================================================================
   ROFI SECLISTS — PALETA TARARCH WARM DARK
   ============================================================================= */

* {
    font:             "Inter 13";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0feb;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.10);
    border-radius:       16px;
    shadow:           false;
    width:            900px;
    padding:          16px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children:         [inputbar, message, listview];
    spacing:          12px;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.05);
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.08);
    border-radius:       12px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       #ff9e64;
    font:             "JetBrainsMono Nerd Font 14";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       #ffffff;
    placeholder:      "Buscar diccionario...";
    placeholder-color: rgba(255, 255, 255, 0.25);
    vertical-align:   0.5;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            12;
    scrollbar:        false;
    spacing:          8px;
    fixed-height:     true;
}

element {
    background-color: rgba(255, 255, 255, 0.04);
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.06);
    border-radius:    12px;
    padding:          8px 14px;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
}

element normal normal {
    text-color: #c9c9c9;
}

element selected normal {
    background-color: rgba(255, 158, 100, 0.18);
    border:           1px;
    border-color:     #ff9e64;
    text-color:       #ffffff;
}

message {
    background-color: transparent;
    padding:          0 4px;
}

textbox {
    background-color: transparent;
    text-color:       rgba(255, 255, 255, 0.45);
    font:             "Inter 11";
}

element-text {
    font:             "JetBrainsMono Nerd Font 11";
}
