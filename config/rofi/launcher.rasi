/* =============================================================================
   ROFI LANZADOR UNIFICADO — PALETA TARARCH WARM DARK
   Pestañas Apps / Comandos / Ventanas (Tab y Shift+Tab). Mismo estilo que
   keybindings.rasi: fondo opaco, buscador sin caja, selección con barra lateral.
   ============================================================================= */

configuration {
    modi:                "drun,Comandos:~/.local/bin/rofi-keys-mode.sh,window";
    show-icons:          true;
    drun-display-format: "{name}";
    display-drun:        "Apps";
    display-window:      "Ventanas";
    disable-history:     false;
    sidebar-mode:        true;

    /* Navegación de pestañas con Tab / Shift+Tab */
    kb-mode-next:        "Tab,Shift+Right,Control+Tab";
    kb-mode-previous:    "ISO_Left_Tab,Shift+Left,Control+ISO_Left_Tab";
    kb-element-next:     "";
    kb-element-prev:     "";
}

* {
    font:             "Inter 11";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0f;
    border:           1px;
    border-color:     #2d2d2d;
    border-radius:    12px;
    width:            720px;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [inputbar, mode-switcher, listview];
    spacing:          0;
}

inputbar {
    padding:          16px 20px 12px 20px;
    spacing:          12px;
    children:         [entry];
}

entry {
    text-color:       #ffffff;
    placeholder:      "Buscar";
    placeholder-color: #6e6e6e;
    vertical-align:   0.5;
    cursor-color:     #ff9e64;
}

/* Pestañas: texto plano, la activa en blanco con subrayado naranja */
mode-switcher {
    padding:          0 14px;
    spacing:          4px;
    border:           0 0 1px 0;
    border-color:     #2d2d2d;
}

button {
    padding:          6px 8px 8px 8px;
    text-color:       #6e6e6e;
    border:           0 0 2px 0;
    border-color:     transparent;
    expand:           false;
    cursor:           pointer;
}

button selected {
    text-color:       #ffffff;
    border-color:     #ff9e64;
}

listview {
    columns:          1;
    lines:            8;
    scrollbar:        false;
    spacing:          0;
    padding:          8px 8px 10px 8px;
    fixed-height:     true;
}

element {
    padding:          7px 12px;
    spacing:          12px;
    border:           0 0 0 2px;
    border-color:     transparent;
    border-radius:    6px;
    cursor:           pointer;
}

element-icon {
    size:             24px;
    cursor:           inherit;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
}

element normal normal,
element alternate normal {
    background-color: transparent;
}

element selected normal {
    background-color: #1c1a19;
    border-color:     #ff9e64;
    text-color:       #ffffff;
}
