/* Lanzador */

configuration {
    modi:                "drun,run";
    show-icons:          true;
    drun-display-format: "{name}";
    display-drun:        " ";
    display-run:         " ";
    disable-history:     false;
    sidebar-mode:        false;
}

* {
    font:             "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0fef;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.10);
    border-radius:    22px;
    width:            620px;
    padding:          18px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children:         [inputbar, listview];
    spacing:          14px;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.05);
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.08);
    border-radius:    14px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       #ff9e64;
    font:             "JetBrainsMono Nerd Font 15";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       #ffffff;
    placeholder:      "Buscar aplicaciones...";
    placeholder-color: rgba(255, 255, 255, 0.25);
    vertical-align:   0.5;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            7;
    scrollbar:        false;
    spacing:          6px;
    fixed-height:     true;
}

element {
    background-color: transparent;
    border-radius:    12px;
    padding:          10px 14px;
    cursor:           pointer;
    spacing:          14px;
}

element-icon {
    size:             32px;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
    font:             "JetBrainsMono Nerd Font 13";
}

element normal normal {
    text-color: #c9c9c9;
}

element selected normal {
    background-color: rgba(255, 158, 100, 0.15);
    border:           1px;
    border-color:     #ff9e64;
    text-color:       #ffffff;
}
