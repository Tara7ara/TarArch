/* =============================================================================
   ROFI MENÚ DE APAGADO — PALETA TARARCH WARM DARK
   Cuatro opciones en fila: icono gris y su nombre debajo; la seleccionada en
   naranja sobre fondo apenas más claro. El markup sale de power-menu.sh.
   ============================================================================= */

* {
    font:             "Inter 10";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0f;
    border:           1px;
    border-color:     #2d2d2d;
    border-radius:    12px;
    width:            520px;
    padding:          10px;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [listview];
}

listview {
    columns:          4;
    lines:            1;
    scrollbar:        false;
    spacing:          6px;
    fixed-height:     true;
}

element {
    padding:          12px 0 8px 0;
    border-radius:    8px;
    cursor:           pointer;
}

element-text {
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           inherit;
}

element normal normal,
element alternate normal {
    background-color: transparent;
    text-color:       #6e6e6e;
}

element selected normal {
    background-color: #1c1a19;
    text-color:       #ff9e64;
}
