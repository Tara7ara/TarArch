/* =============================================================================
   ROFI SSH Y OBJETIVO DEL LAB — PALETA TARARCH WARM DARK
   Mismo estilo que keybindings.rasi: fondo opaco, buscador sin caja y la
   selección con una barra naranja a la izquierda.
   ============================================================================= */

* {
    font:             "Inter 11";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0f;
    border:           1px;
    border-color:     #2d2d2d;
    border-radius:    12px;
    width:            520px;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    children:         [inputbar, message, listview];
    spacing:          0;
}

inputbar {
    padding:          16px 20px;
    spacing:          12px;
    border:           0 0 1px 0;
    border-color:     #2d2d2d;
    children:         [prompt, entry];
}

prompt {
    text-color:       #6e6e6e;
    font:             "Inter 11";
    vertical-align:   0.5;
}

entry {
    text-color:       #ffffff;
    placeholder:      "Buscar";
    placeholder-color: #6e6e6e;
    vertical-align:   0.5;
    cursor-color:     #ff9e64;
}

message {
    padding:          10px 20px 0 20px;
}

textbox {
    text-color:       #6e6e6e;
    font:             "Inter 10";
}

listview {
    columns:          1;
    lines:            4;
    scrollbar:        false;
    spacing:          0;
    padding:          8px 8px 10px 8px;
    fixed-height:     false;
}

element {
    padding:          9px 12px;
    border:           0 0 0 2px;
    border-color:     transparent;
    border-radius:    6px;
    cursor:           pointer;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
}

element normal normal,
element alternate normal {
    background-color: transparent;
}

element selected normal {
    background-color: #1c1a19;
    border-color:     #ff9e64;
    text-color:       #ffffff;
}
