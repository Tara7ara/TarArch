/* =============================================================================
   ROFI CLIPBOARD MANAGER (CLIPHIST) — PALETA TARARCH WARM DARK
   ============================================================================= */

configuration {
    modi:                "dmenu";
    show-icons:          false;
    disable-history:     false;
}

* {
    font:             "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color:       #c9c9c9;
}

window {
    background-color: #0f0f0fef;
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.10);
    border-radius:    22px;
    width:            680px;
    padding:          18px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children:         [inputbar, listview];
    spacing:          14px;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.05);
    border:           1px;
    border-color:     rgba(255, 255, 255, 0.08);
    border-radius:    14px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       #ff9e64;
    font:             "JetBrainsMono Nerd Font 14";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       #ffffff;
    placeholder:      "Buscar en el portapapeles...";
    placeholder-color: rgba(255, 255, 255, 0.25);
    vertical-align:   0.5;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    scrollbar:        false;
    spacing:          6px;
    fixed-height:     true;
}

element {
    background-color: transparent;
    border-radius:    12px;
    padding:          9px 14px;
    cursor:           pointer;
    spacing:          10px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
    font:             "JetBrainsMono Nerd Font 12";
}

element normal normal {
    text-color: #c9c9c9;
}

element selected normal {
    background-color: rgba(255, 158, 100, 0.15);
    border:           1px;
    border-color:     #ff9e64;
    text-color:       #ffffff;
}
