{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // Mismo estilo que el menú de atajos (Super+A): claves en minúscula, naranja
  // y en columna fija; valores en claro; sin iconos por fila.
  // El logo (imagen en Kitty, ASCII o ninguno) lo elige fastfetch-adaptive.sh.
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo.png",
    "width": 20,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "#ff9e64",
      "2": "#ff9e64"
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 12
    },
    // Barra de uso (memoria y disco): línea fina naranja sobre gris, sin corchetes.
    "bar": {
      "char": { "elapsed": "━", "total": "━" },
      "border": { "left": "", "right": "" },
      "color": { "elapsed": "#ff9e64", "total": "#3a3a3a" },
      "width": 10
    },
    // El porcentaje solo cambia de color si se llena: amarillo y luego rojo.
    "percent": {
      "width": 3,
      "color": { "green": "#d6d6d6", "yellow": "#e0af68", "red": "#f7768e" }
    },
    "color": {
      "keys": "#ff9e64",
      "output": "#d6d6d6",
      "title": "#ffffff",
      "separator": "#2d2d2d"
    }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─", "outputColor": "#2d2d2d" },
    { "type": "os", "key": "os", "format": "{name} {arch}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "encendido" },
    { "type": "packages", "key": "paquetes" },
    { "type": "wm", "key": "wm" },
    // Como comando: con la animación, el proceso padre de fastfetch es fastfetch-anim.py
    { "type": "command", "key": "shell", "text": "$SHELL --version | head -1 | awk '{print $1, $2}'" },
    { "type": "terminal", "key": "terminal" },
    "break",
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "memoria", "percent": { "type": 3 }, "format": "{percentage-bar} {percentage}   {used} / {total}" },
    { "type": "disk", "key": "disco", "folders": "/", "percent": { "type": 3 }, "format": "{size-percentage-bar} {size-percentage}   {size-used} / {size-total}" },
    { "type": "custom", "key": "agentes", "format": "claude / codex / agy" }
  ]
}
