[Desktop Entry]
Name=imv-dir
GenericName=Visor de imágenes (carpeta)
GenericName[en_US]=Image viewer (directory)
Comment=Visor rápido de imágenes | Abre todas las imágenes del directorio
Exec=sh -c 'exec "$HOME/.local/bin/imv-dir" "$@"' sh %F
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;Viewer;
MimeType=image/x-farbfeld;image/tiff;image/tiff-fx;image/png;image/x-png;image/jpeg;image/jpg;image/pjpeg;image/svg+xml;image/gif;image/bmp;image/x-bmp;image/heif;image/heic;image/avif;image/jxl;image/webp;image/qoi;image/vnd.microsoft.icon;image/x-icon;image/x-portable-pixmap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-anymap;
Icon=multimedia-photo-viewer
Keywords=photo;picture;imagen;visor;imv;
NoDisplay=false
