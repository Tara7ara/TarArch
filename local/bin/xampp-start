#!/bin/bash
# =============================================================================
# XAMPP CONTROL - START
# =============================================================================

if [ -t 0 ]; then
    sudo /opt/lampp/lampp start
    if [ $? -eq 0 ]; then
        notify-send "XAMPP" "Servicios iniciados correctamente (Apache + MySQL)" -u normal 2>/dev/null
    fi
else
    if command -v pkexec >/dev/null 2>&1; then
        if pkexec /opt/lampp/lampp start; then
            notify-send "XAMPP" "Servicios iniciados correctamente (Apache + MySQL)" -u normal 2>/dev/null
        fi
    else
        kitty --title "XAMPP Start" -e bash -c "sudo /opt/lampp/lampp start; sleep 1"
    fi
fi
