#!/bin/bash
# =============================================================================
# PERFIL DE RED: CASA (DNS Local AdGuard 192.168.1.10)
# Fuerza DNS a 192.168.1.10 en la conexión activa (Ethernet o WiFi)
# =============================================================================

CACHE_FILE="$HOME/.cache/current_network_profile"
ETH_IFACE="eno2"
WLAN_IFACE="wlan0"
HOME_DNS="192.168.1.10,192.168.1.1"

# 1. Configurar Ethernet si está disponible
if ! nmcli con show "Casa Cable" >/dev/null 2>&1; then
    nmcli con add type ethernet con-name "Casa Cable" ifname "$ETH_IFACE" ipv4.method auto ipv4.dns "$HOME_DNS" ipv4.ignore-auto-dns yes 802-3-ethernet.cloned-mac-address permanent 2>/dev/null || true
else
    nmcli con mod "Casa Cable" ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns "$HOME_DNS" ipv4.ignore-auto-dns yes 802-3-ethernet.cloned-mac-address permanent 2>/dev/null || true
fi

ETH_STATE=$(nmcli -g GENERAL.STATE dev show "$ETH_IFACE" 2>/dev/null | cut -d' ' -f1)
if [ "$ETH_STATE" != "20" ] && [ -n "$ETH_STATE" ]; then
    nmcli con up "Casa Cable" >/dev/null 2>&1 || true
fi

# 2. Configurar WiFi activo a DNS de Casa
WIFI_CON=$(nmcli -g GENERAL.CONNECTION dev show "$WLAN_IFACE" 2>/dev/null | head -n1)
if [ -n "$WIFI_CON" ] && [ "$WIFI_CON" != "--" ]; then
    nmcli con mod "$WIFI_CON" ipv4.dns "$HOME_DNS" ipv4.ignore-auto-dns yes 2>/dev/null || true
    nmcli dev reapply "$WLAN_IFACE" >/dev/null 2>&1 || true
fi

# 3. Restaurar DNS en WireGuard
if nmcli con show "Portatil" >/dev/null 2>&1; then
    nmcli con mod "Portatil" ipv4.dns "192.168.1.10" ipv4.dns-priority -10 2>/dev/null || true
    nmcli dev reapply "Portatil" >/dev/null 2>&1 || true
fi

# 4. Guardar estado y notificar
# Lanzado a mano (no por auto-network-watcher.sh): este perfil manda hasta red-auto
MANUAL_FLAG="/run/user/$(id -u)/network-profile-manual"
if [ -z "$RED_AUTO" ]; then
    touch "$MANUAL_FLAG"
    MODO="fijado a mano, red-auto para volver"
else
    MODO="automático"
fi
echo "casa" > "$CACHE_FILE"
notify-send "Perfil de Red" "󰋜 Perfil CASA activado (DNS 192.168.1.10) · $MODO" -i network-transmit-receive -u low
