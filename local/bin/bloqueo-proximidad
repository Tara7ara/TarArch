#!/bin/bash
# Toggle: bloqueo automático de pantalla si el iPhone (Bluetooth) se aleja

SERVICE="bt-proximity-lock.service"

if systemctl --user is-active --quiet "$SERVICE"; then
    systemctl --user stop "$SERVICE"
    rm -f /tmp/bt-proximity-status
    notify-send "Bloqueo por proximidad" "Desactivado" 2>/dev/null
    echo "Bloqueo por proximidad: DESACTIVADO"
else
    systemctl --user start "$SERVICE"
    notify-send "Bloqueo por proximidad" "Activado" 2>/dev/null
    echo "Bloqueo por proximidad: ACTIVADO (bloquea la pantalla si el iPhone se aleja ~45s)"
fi
