#!/usr/bin/env python3
import os
import sys
import shutil
import subprocess
import json

CODEX_DIR = os.path.expanduser("~/.codex")
ACCOUNTS_DIR = os.path.join(CODEX_DIR, "accounts")
AUTH_FILE = os.path.join(CODEX_DIR, "auth.json")
ACTIVE_FILE = os.path.join(ACCOUNTS_DIR, "active_account")

# Ejemplo con 3 cuentas genericas -- edita esto con tus propias cuentas/alias.
ACCOUNTS = {
    "1": {"id": "1", "key": "principal", "email": "cuenta1@example.com", "name": "Cuenta Principal"},
    "2": {"id": "2", "key": "secundaria", "email": "cuenta2@example.com", "name": "Cuenta Secundaria"},
    "3": {"id": "3", "key": "estudio", "email": "cuenta3@example.com", "name": "Cuenta Estudio/Universidad"}
}

ALIAS_MAP = {
    "1": "1", "principal": "1", "cuenta1@example.com": "1",
    "2": "2", "secundaria": "2", "cuenta2@example.com": "2",
    "3": "3", "estudio": "3", "cuenta3@example.com": "3"
}

def ensure_dirs():
    os.makedirs(ACCOUNTS_DIR, mode=0o700, exist_ok=True)

def get_active_id():
    if os.path.exists(ACTIVE_FILE):
        try:
            with open(ACTIVE_FILE, "r") as f:
                val = f.read().strip()
                if val in ACCOUNTS:
                    return val
        except Exception:
            pass
    return None

def is_account_saved(acc_id):
    path = os.path.join(ACCOUNTS_DIR, f"{acc_id}.json")
    return os.path.exists(path) and os.path.getsize(path) > 0

def save_current_as(acc_id):
    ensure_dirs()
    if not os.path.exists(AUTH_FILE) or os.path.getsize(AUTH_FILE) == 0:
        print(f"\033[31m[!] Error:\033[0m No hay ninguna sesión activa en '{AUTH_FILE}'. Inicia sesión primero con 'codex login'.")
        return False

    dest = os.path.join(ACCOUNTS_DIR, f"{acc_id}.json")
    shutil.copy2(AUTH_FILE, dest)
    os.chmod(dest, 0o600)
    with open(ACTIVE_FILE, "w") as f:
        f.write(acc_id)
    acc = ACCOUNTS[acc_id]
    print(f"\033[32m[✓] Guardada sesión de la cuenta #{acc_id}:\033[0m {acc['email']} ({acc['name']})")
    subprocess.run(["notify-send", "Codex Auth", f"Sesión guardada para: {acc['email']}", "-i", "dialog-password"], stdout=subprocess.DEVNULL)
    return True

def switch_to(acc_id):
    ensure_dirs()
    src = os.path.join(ACCOUNTS_DIR, f"{acc_id}.json")
    if not os.path.exists(src):
        acc = ACCOUNTS[acc_id]
        print(f"\033[33m[!] La cuenta #{acc_id} ({acc['email']}) aún no tiene sesión guardada.\033[0m")
        print(f"    Para configurarla, ejecuta: \033[1mcodex-acc login {acc_id}\033[0m")
        return False

    shutil.copy2(src, AUTH_FILE)
    os.chmod(AUTH_FILE, 0o600)
    with open(ACTIVE_FILE, "w") as f:
        f.write(acc_id)
    acc = ACCOUNTS[acc_id]
    print(f"\033[32m[✓] Cuenta activa cambiada a:\033[0m #{acc_id} - {acc['email']} ({acc['name']})")
    subprocess.run(["notify-send", "Codex Auth", f"Cuenta activa: {acc['email']}", "-i", "emblem-default"], stdout=subprocess.DEVNULL)
    return True

def switch_next():
    active = get_active_id()
    saved = [k for k in list(ACCOUNTS.keys()) if is_account_saved(k)]
    if not saved:
        print("\033[31m[!] No hay ninguna cuenta guardada todavía.\033[0m Usa 'codex-acc login 1' para empezar.")
        return False
    if not active or active not in saved:
        next_id = saved[0]
    else:
        idx = saved.index(active)
        next_id = saved[(idx + 1) % len(saved)]
    return switch_to(next_id)

def show_status():
    active = get_active_id()
    print("\n\033[1;34m=== GESTOR DE CUENTAS CODEX (TARARCH) ===\033[0m\n")
    for k in list(ACCOUNTS.keys()):
        acc = ACCOUNTS[k]
        is_active = (k == active)
        saved = is_account_saved(k)
        
        status_mark = "\033[32m[ACTIVA]\033[0m" if is_active else ("\033[36m[Guardada]\033[0m" if saved else "\033[90m[Sin sesión]\033[0m")
        num_color = "\033[1;32m" if is_active else "\033[1;37m"
        print(f" {num_color}{k})\033[0m {acc['email']:<36} {status_mark:<15} \033[90m({acc['name']})\033[0m")
    
    print("\n\033[1mComandos útiles:\033[0m")
    print("  \033[33mcodex-acc <1|2|3>\033[0m    Cambiar a esa cuenta al instante")
    print("  \033[33mcodex-acc next\033[0m         Pasar a la siguiente cuenta (ideal al llegar al límite)")
    print("  \033[33mcodex-acc login <1-3>\033[0m  Iniciar sesión en el navegador y guardar automáticamente")
    print("  \033[33mcodex-acc save <1-3>\033[0m   Guardar la sesión actual (auth.json) en ese slot\n")

def login_flow(acc_id):
    acc = ACCOUNTS[acc_id]
    print(f"\n\033[1;36m[+] Iniciando login para cuenta #{acc_id}: {acc['email']} ({acc['name']})...\033[0m")
    print("1. Si tienes otra sesión abierta en el navegador, asegúrate de entrar con este correo.")
    print("2. Abriendo 'codex login'...\n")
    try:
        # Solo eliminamos el archivo local si existe; NO hacemos 'codex logout' para que OpenAI no revoque el token anterior
        if os.path.exists(AUTH_FILE):
            os.remove(AUTH_FILE)
        res = subprocess.run(["codex", "login"])
        if res.returncode == 0 and os.path.exists(AUTH_FILE):
            save_current_as(acc_id)
        else:
            print("\033[31m[!] El login no se completó o falló.\033[0m")
    except Exception as e:
        print(f"\033[31m[!] Error durante el login:\033[0m {e}")

def rofi_menu():
    active = get_active_id()
    menu_lines = []
    
    for k in list(ACCOUNTS.keys()):
        acc = ACCOUNTS[k]
        is_active = (k == active)
        saved = is_account_saved(k)
        
        if is_active:
            tag = "<span color='#9ece6a'><b>[ACTIVA]</b></span>"
            icon = "<span color='#9ece6a'>󰄲</span>"
        elif saved:
            tag = "<span color='#7aa2f7'>[Guardada]</span>"
            icon = "<span color='#7aa2f7'>󰄱</span>"
        else:
            tag = "<span color='#787c99'>[Sin login]</span>"
            icon = "<span color='#787c99'>󰅖</span>"
            
        line = f"{icon}  <b>{k}. {acc['email']}</b>  {tag}  <span color='#787c99'>({acc['name']})</span>"
        menu_lines.append(line)
        
    menu_lines.append("<span color='#ff9e64'>󰑐</span>  <b>Siguiente cuenta (rotar límite)</b>")
    
    input_str = "\n".join(menu_lines)
    
    try:
        proc = subprocess.Popen(
            ["rofi", "-dmenu", "-p", "󰚩 Codex", "-theme", os.path.expanduser("~/.config/rofi/cursor-menu.rasi"), "-markup-rows", "-no-custom", "-hover-select", "-me-select-entry", "", "-me-accept-entry", "MousePrimary", "-cache-file", "/dev/null"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        out, _ = proc.communicate(input=input_str)
        selected = out.strip()
        
        if not selected:
            return
            
        if "Siguiente cuenta" in selected:
            switch_next()
        else:
            for k in list(ACCOUNTS.keys()):
                if f"{k}. " in selected or ACCOUNTS[k]["email"] in selected:
                    if is_account_saved(k):
                        switch_to(k)
                    else:
                        subprocess.run(["notify-send", "Codex Auth", f"La cuenta #{k} no tiene sesión. Ejecuta 'codex-acc login {k}' en Kitty.", "-u", "critical"], stdout=subprocess.DEVNULL)
                    break
    except Exception as e:
        print(f"Error en Rofi: {e}")

def main():
    ensure_dirs()
    if len(sys.argv) == 1:
        if sys.stdout.isatty():
            show_status()
        else:
            rofi_menu()
        return

    arg = sys.argv[1].lower()

    if arg in ["--rofi", "-r", "menu"]:
        rofi_menu()
        return

    if arg in ["status", "list", "ls", "-l", "--status"]:
        show_status()
        return

    if arg in ["next", "rotate", "rotar", "siguiente", "-n"]:
        switch_next()
        return

    if arg == "save":
        if len(sys.argv) < 3:
            active = get_active_id()
            if active:
                save_current_as(active)
            else:
                print("Especifica qué cuenta guardar: codex-acc save <1|2|3>")
        else:
            target = ALIAS_MAP.get(sys.argv[2].lower())
            if target:
                save_current_as(target)
            else:
                print(f"Cuenta desconocida: {sys.argv[2]}. Usa 1, 2, 3 o 4.")
        return

    if arg == "login":
        if len(sys.argv) < 3:
            print("Especifica la cuenta para loguearte: codex-acc login <1|2|3>")
        else:
            target = ALIAS_MAP.get(sys.argv[2].lower())
            if target:
                login_flow(target)
            else:
                print(f"Cuenta desconocida: {sys.argv[2]}. Usa 1, 2, 3 o 4.")
        return

    target = ALIAS_MAP.get(arg)
    if target:
        switch_to(target)
        return

    print(f"Opción no reconocida: '{arg}'. Ejecuta 'codex-acc' para ver las opciones.")

if __name__ == "__main__":
    main()
