#!/usr/bin/env python3
# =============================================================================
# tararch-dash — panel de estado de TarArch (Super+Tab, otra vez lo cierra).
#   Webview GTK como wallpaper-flow. Todo sale de datos reales del sistema:
#   uso de CPU/memoria/disco, temperatura, red (IPs, VPN, tun0, objetivo de
#   set-target), modo del sistema, escritorios con sus ventanas, próximos
#   eventos (caché del Centro de Control), estado del backup y atajos.
#   Clic en un escritorio va a él; clic en una IP la copia. Esc cierra.
# =============================================================================
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2, GLib
import datetime, html, json, os, shutil, signal, subprocess, sys

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
LOGO = os.path.join(HOME, ".config/hypr/icons/logo-lock.png")

# Instancia única: si ya está abierto, Super+Tab lo cierra.
_LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "tararch-dash.pid")
try:
    with open(_LOCK) as f:
        os.kill(int(f.read().strip()), signal.SIGTERM)
    os.remove(_LOCK)
    sys.exit(0)
except (OSError, ValueError):
    pass
with open(_LOCK, "w") as f:
    f.write(str(os.getpid()))


def sh(cmd):
    try:
        return subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                              text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def leer(path, defecto=""):
    try:
        with open(os.path.expanduser(path)) as f:
            return f.read().strip()
    except OSError:
        return defecto


# --- Sistema ------------------------------------------------------------------
_cpu_prev = None


def cpu_uso():
    global _cpu_prev
    campos = [int(x) for x in leer("/proc/stat").split("\n")[0].split()[1:]]
    idle, total = campos[3] + campos[4], sum(campos)
    uso = 0
    if _cpu_prev:
        d_total, d_idle = total - _cpu_prev[1], idle - _cpu_prev[0]
        uso = round(100 * (d_total - d_idle) / d_total) if d_total else 0
    _cpu_prev = (idle, total)
    return uso


def memoria():
    info = {}
    for linea in leer("/proc/meminfo").split("\n"):
        k, v = linea.split(":")
        info[k] = int(v.split()[0])
    total, libre = info["MemTotal"], info["MemAvailable"]
    return (total - libre) / 1048576, total / 1048576


def temperatura():
    base = "/sys/class/thermal"
    for z in sorted(os.listdir(base)):
        if leer(f"{base}/{z}/type") == "x86_pkg_temp":
            return round(int(leer(f"{base}/{z}/temp", "0")) / 1000)
    return None


def ventiladores():
    base = "/sys/class/hwmon"
    for h in os.listdir(base):
        if leer(f"{base}/{h}/name") == "asus":
            rpm = [int(leer(f"{base}/{h}/{f}", "0")) for f in sorted(os.listdir(f"{base}/{h}"))
                   if f.startswith("fan") and f.endswith("_input")]
            return rpm
    return []


def encendido():
    s = int(float(leer("/proc/uptime", "0").split()[0]))
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return " ".join(p for p in (f"{d} d" if d else "", f"{h} h" if h else "", f"{m} min") if p)


# --- Red ----------------------------------------------------------------------
def red():
    ifaces = []
    try:
        for i in json.loads(sh(["ip", "-j", "addr"]) or "[]"):
            v4 = [a["local"] for a in i.get("addr_info", []) if a.get("family") == "inet"]
            if i["ifname"] != "lo" and v4:
                ifaces.append({"nombre": i["ifname"], "ip": v4[0]})
    except ValueError:
        pass
    vpn = next((i for i in ifaces if i["nombre"] == "Portatil"), None)
    tun = next((i for i in ifaces if i["nombre"].startswith("tun")), None)
    lan = [i for i in ifaces if i not in (vpn, tun)]
    return {
        "perfil": leer("~/.cache/current_network_profile", "-"),
        "lan": lan,
        "vpn": vpn["ip"] if vpn else None,
        "tun": tun["ip"] if tun else None,
        "objetivo": leer("~/.local/state/target") or None,
    }


# --- Escritorios --------------------------------------------------------------
def escritorios():
    try:
        wss = json.loads(sh(["hyprctl", "workspaces", "-j"]) or "[]")
        clientes = json.loads(sh(["hyprctl", "clients", "-j"]) or "[]")
        activo = json.loads(sh(["hyprctl", "activeworkspace", "-j"]) or "{}").get("id")
    except ValueError:
        return []
    res = []
    for w in sorted(wss, key=lambda w: w["id"]):
        if w["id"] < 1:
            continue
        apps = [{"clase": (c.get("class") or c.get("initialClass") or "?").split(".")[-1],
                 "titulo": c.get("title", "")}
                for c in clientes
                if c.get("workspace", {}).get("id") == w["id"] and c.get("mapped", True)
                and c.get("class") != "tararch-dash"]
        if apps:
            res.append({"id": w["id"], "apps": apps, "activo": w["id"] == activo})
    return res


# --- Agenda y backup ------------------------------------------------------------
DIAS = ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"]
MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"]


def eventos(n=3):
    try:
        evs = json.loads(leer("~/.cache/tararch_calendar_index.json", "{}"))["events"]
    except (ValueError, KeyError):
        return []
    ahora = datetime.datetime.now()
    hoy = ahora.date()
    lista = []
    for ev in evs:
        try:
            fecha = datetime.date.fromisoformat(ev["date"])
        except (KeyError, ValueError):
            continue
        if ev.get("yearly"):
            fecha = fecha.replace(year=hoy.year)
            if fecha < hoy:
                fecha = fecha.replace(year=hoy.year + 1)
        hora = ev.get("time") or ""
        try:
            t = datetime.time.fromisoformat(hora) if hora else datetime.time.max
        except ValueError:
            t = datetime.time.max
        momento = datetime.datetime.combine(fecha, t)
        if momento < ahora:
            continue
        if fecha == hoy:
            dia = "hoy"
        elif fecha == hoy + datetime.timedelta(days=1):
            dia = "mañana"
        else:
            dia = f"{DIAS[fecha.weekday()]} {fecha.day} {MESES[fecha.month - 1]}"
        lista.append((momento, f"{dia} {hora}".strip(), ev.get("summary", "").strip()))
    return [{"cuando": c, "titulo": t} for _, c, t in sorted(lista)[:n]]


def backup():
    try:
        d = json.loads(sh([os.path.join(BIN, "backup-status.sh")]) or "{}")
        return {"estado": d.get("class", ""), "texto": d.get("tooltip", "").split("\n")[0]}
    except ValueError:
        return {"estado": "", "texto": ""}


def atajos(n=8):
    """Las primeras filas de "Aplicaciones" y "Herramientas" de Super+A."""
    salida = sh(["bash", "-c", f'source {BIN}/keybindings-lib.sh; printf "%s\\n" "${{KEYBINDINGS_LIST[@]}}"'])
    res, seccion = [], ""
    for linea in salida.split("\n"):
        if linea.startswith("# "):
            seccion = linea[2:]
        elif "|" in linea and seccion in ("Aplicaciones", "Herramientas"):
            k, d = linea.split("|", 1)
            if k.startswith("Super") and k != "Super + A":
                res.append({"tecla": k.replace(" + ", "+"), "desc": d})
    return res[:n]


def estado():
    usado, total = memoria()
    disco = shutil.disk_usage("/")
    return {
        "usuario": f"{os.environ.get('USER', '')}@{os.uname().nodename}",
        "cpu": cpu_uso(),
        "mem": [round(usado, 1), round(total, 1)],
        "disco": [round(disco.used / 2**30), round(disco.total / 2**30)],
        "temp": temperatura(),
        "fans": ventiladores(),
        "encendido": encendido(),
        "modo": leer("~/.cache/current_system_mode", "normal"),
        "red": red(),
        "escritorios": escritorios(),
        "eventos": eventos(),
        "backup": backup(),
    }


# --- Página -------------------------------------------------------------------
PAGINA = r"""<!doctype html><html><head><meta charset="utf-8"><style>
