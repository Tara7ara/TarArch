def enviar(view, fn, datos):
    view.evaluate_javascript(f"{fn}({json.dumps(datos, ensure_ascii=False)})", -1, None, None, None)


def on_message(_manager, valor):
    msg = valor.to_string()
    if msg == "close":
        cerrar()
    elif msg.startswith("ws:"):
        subprocess.Popen(["hyprctl", "dispatch", "workspace", msg[3:]], stdout=subprocess.DEVNULL)
        cerrar()
    elif msg.startswith("copy:"):
        ip = msg[5:]
        subprocess.run(["wl-copy", "-n", ip])
        subprocess.Popen(["notify-send", "-u", "low", "IP copiada", ip])


def cerrar(*_):
    try:
        os.remove(_LOCK)
    except OSError:
        pass
    Gtk.main_quit()


# En Wayland la clase de la ventana (app_id) sale del prgname; la regla de
# Hyprland busca "tararch-dash".
GLib.set_prgname("tararch-dash")
win = Gtk.Window(title="TarArch")
win.set_default_size(1100, 640)
win.set_decorated(False)
win.connect("destroy", cerrar)

ucm = WebKit2.UserContentManager()
ucm.register_script_message_handler("dash")
ucm.connect("script-message-received::dash", on_message)
view = WebKit2.WebView.new_with_user_content_manager(ucm)
view.set_background_color(__import__("gi.repository.Gdk", fromlist=["RGBA"]).RGBA(0.059, 0.059, 0.059, 1))
cpu_uso()   # primera lectura, para que la siguiente ya tenga con qué comparar


def al_cargar(v, evento):
    if evento == WebKit2.LoadEvent.FINISHED:
        enviar(v, "atajosPinta", atajos())
        refrescar()


def refrescar():
    enviar(view, "update", estado())
    return True


view.connect("load-changed", al_cargar)
view.load_html(PAGINA.replace("LOGO", "file://" + LOGO), "file:///")
GLib.timeout_add(2000, refrescar)
win.add(view)
win.show_all()
Gtk.main()
